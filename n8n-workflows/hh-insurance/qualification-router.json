{
  "name": "hh-insurance--qualification-router",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        200,
        600
      ],
      "notes": "Input: contact_id, contact_email, phone, first_name, last_name, intake_form_payload (age, marital_status, dependents, occupation, coverage_now, primary_concern, urgency, income_bracket, free_text). Output: contact routed into exactly one of 6 HH Insurance tracks OR flagged for Nick triage if confidence < threshold."
    },
    {
      "parameters": {
        "url": "={{ $env.BENTLEY_HTTP_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.BENTLEY_HTTP_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ skill: \"qualify-insurance-lead\", contact: { id: $json.contact_id, email: $json.contact_email, first_name: $json.first_name, phone: $json.phone }, intake: $json.intake_form_payload, instructions: \"Classify into exactly one of: young-parent | wealth-building | term-to-IUL | urgent-no-coverage | business-owner | re-engage. Use SOUL.md voice for the suggested_first_touch_copy. Return JSON with track, confidence (0..1), reasoning, suggested_first_touch_copy.\" }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "bentley-classify",
      "name": "Bentley: Classify Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        600
      ],
      "continueOnFail": true,
      "notes": "Path B hybrid: n8n owns I/O + state, Bentley owns the judgment. continueOnFail catches Bentley HTTP outages so the triage branch fires."
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "low",
                    "leftValue": "={{ $json.confidence || 0 }}",
                    "rightValue": 0.6,
                    "operator": {
                      "type": "number",
                      "operation": "lt"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "low_confidence_triage"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "yp",
                    "leftValue": "={{ $json.track }}",
                    "rightValue": "young-parent",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "young_parent"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "wb",
                    "leftValue": "={{ $json.track }}",
                    "rightValue": "wealth-building",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "wealth_building"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "t2i",
                    "leftValue": "={{ $json.track }}",
                    "rightValue": "term-to-IUL",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "term_to_iul"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "urg",
                    "leftValue": "={{ $json.track }}",
                    "rightValue": "urgent-no-coverage",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "urgent_no_coverage"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "bo",
                    "leftValue": "={{ $json.track }}",
                    "rightValue": "business-owner",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "business_owner"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "re",
                    "leftValue": "={{ $json.track }}",
                    "rightValue": "re-engage",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "re_engage"
            }
          ],
          "fallbackOutput": "extra",
          "renameFallbackOutput": "unknown_track"
        },
        "options": {}
      },
      "id": "route",
      "name": "Route by Track",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        640,
        600
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ce",
              "name": "contact_email",
              "value": "={{ $node[\"When Called\"].json.contact_email }}",
              "type": "string"
            },
            {
              "id": "props",
              "name": "properties",
              "value": "={{ { hh_insurance_track: \"young-parent\", hh_insurance_young_parent_step: 0, hh_insurance_young_parent_state: \"active\", hh_insurance_young_parent_enrolled_at: $now.toISO(), hh_insurance_classification_confidence: $json.confidence, hh_insurance_classification_reasoning: $json.reasoning } }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "enroll-yp",
      "name": "Enroll: Young Parent",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
