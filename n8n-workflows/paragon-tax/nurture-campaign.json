            { "id": "p2", "name": "subject", "value": "Welcome to the Paragon Tax circle", "type": "string" },
            { "id": "p3", "name": "body_html", "value": "<p>Hi {{ $json.first_name }},</p><p>Thanks for joining the Paragon Tax list. Every two to four weeks I share one practical move that has saved real clients real money - never sales fluff. First one lands in your inbox in about two weeks.</p><p>Reply anytime with questions.</p><p>- Hiro<br>Paragon Tax</p>", "type": "string" },
            { "id": "p4", "name": "business_unit", "value": "paragon_tax", "type": "string" },
            { "id": "p5", "name": "lead_id", "value": "={{ $json.contact_id }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "build-payload",
      "name": "Build Email Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": { "workflowId": "lib-send-email", "workflowInputs": { "value": "={{ $json }}" } },
      "id": "send-email",
      "name": "Call lib--send-email",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "ce", "name": "contact_email", "value": "={{ $json.contact_email }}", "type": "string" },
            { "id": "props", "name": "properties", "value": "={{ { paragon_nurture_step: 1, paragon_nurture_last_action_at: $now.toISO(), paragon_nurture_state: \"active\" } }}", "type": "object" }
          ]
        },
        "options": {}
      },
      "id": "build-state-update",
      "name": "Build State Update",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [900, 300]
    },
    {
      "parameters": { "workflowId": "lib-update-hubspot-contact", "workflowInputs": { "value": "={{ $json }}" } },
