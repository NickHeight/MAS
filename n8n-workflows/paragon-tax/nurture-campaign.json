            { "id": "ts", "name": "executed_at", "value": "={{ $now.toISO() }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "result",
      "name": "Sequence Step Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
