{
  "name": "paragon-tax--nurture-campaign",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "notes": "PROOF-OF-PATTERN: Step 0 only. Cadence Day 0,14,30,45,60,90 (6 steps total). Email-led. State on HubSpot: paragon_nurture_step, paragon_nurture_last_action_at, paragon_nurture_state. Default for cold leads who do not book."
